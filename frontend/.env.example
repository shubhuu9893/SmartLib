# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: use the local Firebase Auth emulator (e.g. 127.0.0.1:9099)
# VITE_FIREBASE_AUTH_EMULATOR_HOST=

# Backend base URL. Defaults to /api, which the Vite dev server proxies to VITE_DEV_BACKEND_URL.
# VITE_API_BASE_URL=/api
# VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
