DATABASE_URL=postgresql://postgres:password@localhost:5432/e_library

# Firebase project used by the frontend; required to verify Firebase ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: path to a Firebase service-account JSON (not required for token verification).
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# Optional: set when using the Firebase Auth emulator locally.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo account created by `python -m app.seed_demo` (defaults shown).
# DEMO_USER_EMAIL=demo@smartlib.dev
# DEMO_USER_PASSWORD=Demo@1234
